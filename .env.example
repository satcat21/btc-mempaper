# mempaper environment configuration
# Copy this file to .env and adjust values as needed.
# The .env file is ignored by git and never committed.

# Optional: API token for fetching release notes from private Git repositories.
# Without this, the updater falls back to local git tags (updates still work,
# but release notes won't be shown in the web UI).
#
# GitHub: Personal Access Token with "repo" scope
#   https://github.com/settings/tokens
#
# GitLab: Personal Access Token with "read_api" scope
#   https://<your-gitlab>//-/user_settings/personal_access_tokens
#
# GIT_API_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GIT_API_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
#
# Which release API the remote has: github, gitlab, gitea or git. Leave this
# out and it is worked out from the remote, asking the host where its name
# does not settle it. Set it to skip the asking, and to keep the token above
# from being offered to a host you do not run.
#
# 'git' is any remote that has tags but no release objects - an ngit/GRASP
# server, a nostr remote, a plain mirror. Updates work the same there: the
# version list is built from tags either way, and only the release notes
# beside each version are missing.
#
# GIT_API_KIND=gitea
