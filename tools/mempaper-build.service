# /etc/systemd/system/mempaper-build.service
# Package work that takes hours: source builds, and pip installs that turn into
# source builds. Installed by install_permissions.sh.
#
# Not enabled or autostarted — mempaper writes a job queue and starts this unit
# on demand via 'sudo systemctl start mempaper-build.service'.
#
# The point of it being a unit of its own is the control group. pip used to run
# as a thread inside mempaper.service, so KillMode=control-group took it down
# with the app — and the update flow ends by restarting the app, which meant
# every update destroyed whatever was building. A separate unit is a separate
# cgroup: restarting mempaper.service no longer reaches it, and the build
# carries on across as many restarts as it takes.

[Unit]
Description=mempaper package build worker
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple, not oneshot: the unit is 'active' for as long as the worker runs,
# which is what the web UI asks systemd about, and no start timeout applies to a
# build measured in hours.
Type=simple
Restart=no
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/.venv/bin/python __PROJECT_DIR__/tools/build_worker.py

# Let the kernel use swap freely while a build is running, and only then.
#
# postinstall.sh sets vm.swappiness=1 as the standing value, so a running
# service stays in RAM and nothing is written to the card for no reason. That
# is the right default and the wrong one for a compile: at 1 the kernel
# reclaims page cache in preference to swapping, so an hours-long build drops
# the headers and sources it is about to read again and fetches them back off
# the SD card, over and over. Parking cold anonymous pages instead is both
# faster and easier on the card.
#
# The unit is the only thing that knows when a build is happening, which is why
# this lives here rather than around the code that starts one. ExecStopPost runs
# on success, on failure, and when the Stop button in the web UI stops the unit,
# so the standing value cannot be left raised.
#
# '+' runs these two as root despite User= below, so they need no sudoers grant
# of their own. Both are '-' prefixed as well: a kernel that will not take the
# setting is a reason to build without it, not a reason to refuse to build.
ExecStartPre=+-/usr/sbin/sysctl -q -w vm.swappiness=60
ExecStopPost=+-/usr/sbin/sysctl -q -w vm.swappiness=1

# And the swap file itself, which is registered noauto and off the rest of the
# time - see tools/setup_swap.sh. A source build on a 512 MB Pi Zero is the
# reason it exists; a dashboard serving pages only wears the card with it.
# Holders are counted by the helper, so an apt step running alongside this
# keeps its own hold and neither release switches the file off too early.
ExecStartPre=+-/usr/local/bin/mempaper-swap acquire build
ExecStopPost=+-/usr/local/bin/mempaper-swap release build

# Stop means stop. The worker terminates its own pip child on SIGTERM and
# records where it got to, so the Stop button in the web UI is prompt and the
# queue survives to be resumed.
TimeoutStopSec=30
KillMode=control-group

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mempaper-build
